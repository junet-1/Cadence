<workout_file>
    <author>Cadence</author>
    <name>40/20 3 × 8 min</name>
    <description>40 s hart / 20 s locker in Blöcken: 3 × 8 Wiederholungen bei 125 % / 35 % FTP, 5 min zwischen den Blöcken. Übliche Werte: 120–145 % hart, ~35 % locker; spät im Block wird es zäh.</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="720" PowerLow="0.50" PowerHigh="0.78"/>
        <SteadyState Duration="180" Power="0.55"/>
        <IntervalsT Repeat="8" OnDuration="40" OffDuration="20" OnPower="1.25" OffPower="0.35"/>
        <SteadyState Duration="300" Power="0.50"/>
        <IntervalsT Repeat="8" OnDuration="40" OffDuration="20" OnPower="1.25" OffPower="0.35"/>
        <SteadyState Duration="300" Power="0.50"/>
        <IntervalsT Repeat="8" OnDuration="40" OffDuration="20" OnPower="1.25" OffPower="0.35"/>
        <Cooldown Duration="600" PowerLow="0.60" PowerHigh="0.40"/>
    </workout>
</workout_file>
