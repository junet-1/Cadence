<workout_file>
    <author>Kurbel</author>
    <name>Erholung 45 min</name>
    <description>Aktive Erholung (Zone 1, unter 55 % FTP): locker kurbeln, Beine durchbewegen. Für den Tag nach harten Einheiten.</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.40" PowerHigh="0.50"/>
        <SteadyState Duration="2100" Power="0.50"/>
        <Cooldown Duration="300" PowerLow="0.50" PowerHigh="0.40"/>
    </workout>
</workout_file>
