<workout_file>
    <author>Kurbel</author>
    <name>Rønnestad 30/15</name>
    <description>Kurze Intervalle nach Rønnestad et al. (2020): 3 Sätze × 13 × (30 s hart / 15 s locker), 3 min zwischen den Sätzen. In der Studie „so hart wie durchhaltbar“; hier 125 % / 50 % FTP.</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.50" PowerHigh="0.80"/>
        <SteadyState Duration="180" Power="0.55"/>
        <IntervalsT Repeat="13" OnDuration="30" OffDuration="15" OnPower="1.25" OffPower="0.50"/>
        <SteadyState Duration="180" Power="0.50"/>
        <IntervalsT Repeat="13" OnDuration="30" OffDuration="15" OnPower="1.25" OffPower="0.50"/>
        <SteadyState Duration="180" Power="0.50"/>
        <IntervalsT Repeat="13" OnDuration="30" OffDuration="15" OnPower="1.25" OffPower="0.50"/>
        <Cooldown Duration="600" PowerLow="0.60" PowerHigh="0.40"/>
    </workout>
</workout_file>
