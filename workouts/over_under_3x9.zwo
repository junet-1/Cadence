<workout_file>
    <author>Kurbel</author>
    <name>Over-Unders 3 × 9 min</name>
    <description>Wechsel um die Schwelle: je 9 min aus 3 × (2 min „unter“ bei 92 % + 1 min „über“ bei 107 % FTP), 5 min Pause. Üblich: unter 90–95 %, über 102–110 % FTP – trainiert Laktatabbau unter Last.</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="720" PowerLow="0.50" PowerHigh="0.78"/>
        <SteadyState Duration="180" Power="0.60"/>
        <IntervalsT Repeat="3" OnDuration="120" OffDuration="60" OnPower="0.92" OffPower="1.07"/>
        <SteadyState Duration="300" Power="0.55"/>
        <IntervalsT Repeat="3" OnDuration="120" OffDuration="60" OnPower="0.92" OffPower="1.07"/>
        <SteadyState Duration="300" Power="0.55"/>
        <IntervalsT Repeat="3" OnDuration="120" OffDuration="60" OnPower="0.92" OffPower="1.07"/>
        <Cooldown Duration="600" PowerLow="0.60" PowerHigh="0.40"/>
    </workout>
</workout_file>
