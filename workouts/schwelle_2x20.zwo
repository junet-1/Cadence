<workout_file>
    <author>Kurbel</author>
    <name>Schwelle 2 × 20 min</name>
    <description>Der Klassiker an der Schwelle: 2 × 20 min bei 95 % FTP mit 5 min Erholung. Lange Blöcke von 15–30 min mit 2–4 min Pause sind das übliche Schwellenformat.</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.50" PowerHigh="0.75"/>
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="60" OnPower="1.00" OffPower="0.60"/>
        <SteadyState Duration="180" Power="0.60"/>
        <IntervalsT Repeat="2" OnDuration="1200" OffDuration="300" OnPower="0.95" OffPower="0.55"/>
        <Cooldown Duration="600" PowerLow="0.60" PowerHigh="0.40"/>
    </workout>
</workout_file>
