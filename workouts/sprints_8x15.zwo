<workout_file>
    <author>Cadence</author>
    <name>Sprints 8 × 15 s</name>
    <description>Neuromuskuläre Spitzen: 8 Vollgas-Sprints à 15 s (Trainer frei, alles was geht), dazwischen 4:45 min ganz locker. Lange Pausen sind Absicht: jeder Sprint soll frisch sein.</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.50" PowerHigh="0.75"/>
        <SteadyState Duration="180" Power="0.55"/>
        <MaxEffort Duration="15"/>
        <SteadyState Duration="285" Power="0.45"/>
        <MaxEffort Duration="15"/>
        <SteadyState Duration="285" Power="0.45"/>
        <MaxEffort Duration="15"/>
        <SteadyState Duration="285" Power="0.45"/>
        <MaxEffort Duration="15"/>
        <SteadyState Duration="285" Power="0.45"/>
        <MaxEffort Duration="15"/>
        <SteadyState Duration="285" Power="0.45"/>
        <MaxEffort Duration="15"/>
        <SteadyState Duration="285" Power="0.45"/>
        <MaxEffort Duration="15"/>
        <SteadyState Duration="285" Power="0.45"/>
        <MaxEffort Duration="15"/>
        <SteadyState Duration="285" Power="0.45"/>
        <Cooldown Duration="600" PowerLow="0.55" PowerHigh="0.40"/>
    </workout>
</workout_file>
