<workout_file>
    <author>Cadence</author>
    <name>Seiler 4 × 8 min</name>
    <description>Nach Seiler et al. (2013): 4 × 8 min an der oberen Grenze des Durchhaltbaren (~90 % HFmax) mit 2 min Pause – brachte in der Studie mehr als 4 × 4 und 4 × 16 min. Hier 105 % FTP; wer kann, hält mehr.</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="900" PowerLow="0.50" PowerHigh="0.80"/>
        <SteadyState Duration="180" Power="0.60"/>
        <IntervalsT Repeat="4" OnDuration="480" OffDuration="120" OnPower="1.05" OffPower="0.50"/>
        <Cooldown Duration="600" PowerLow="0.60" PowerHigh="0.40"/>
    </workout>
</workout_file>
