        <SteadyState Duration="300" Power="1.00"/>
        <SteadyState Duration="120" Power="0.55"/>
        <SteadyState Duration="300" Power="1.00"/>
        <SteadyState Duration="240" Power="0.70"/>
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="60" OnPower="1.20" OffPower="0.50"/>
        <Cooldown Duration="420" PowerLow="0.65" PowerHigh="0.40"/>
    </workout>
</workout_file>
