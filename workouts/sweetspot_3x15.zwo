<workout_file>
    <author>Cadence</author>
    <name>Sweet Spot 3 × 15 min</name>
    <description>Drei Blöcke im Sweet Spot (88–94 % FTP, hier 90 %) mit 5 min lockerer Erholung – typischer Aufbau 3 × 15 min bei 88–93 % / 5 min Pause (Roadman Cycling). Viel Schwellenreiz bei moderater Ermüdung.</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.50" PowerHigh="0.75"/>
        <SteadyState Duration="180" Power="0.75"/>
        <IntervalsT Repeat="3" OnDuration="900" OffDuration="300" OnPower="0.90" OffPower="0.55"/>
        <Cooldown Duration="480" PowerLow="0.60" PowerHigh="0.40"/>
    </workout>
</workout_file>
